# Copy to .env and fill in. Never commit a .env with values.

# From @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Webhook mode only: 32-256 characters of A-Z, a-z, 0-9, "_" and "-".
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Tests and local mocks only. Leave empty: the bot reads https://heyresearch.xyz (https only).
HEY_BASE_URL=

# Port the webhook server listens on. Empty means 8080.
PORT=

# debug, info, warn or error. Empty means info.
LOG_LEVEL=
